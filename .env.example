# Kenya Fund Finder — Supabase project qrmthciurngpzpjhevdj (currently reachable).
# Copy to .env and fill in values. Never commit .env.

# --- Frontend (Vite; safe to expose in browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Local dev only (npm run dev): skip Turnstile when Cloudflare is unreachable.
# Ignored in production builds (import.meta.env.DEV is false).
# VITE_DISABLE_TURNSTILE_DEV=true

# Phase-1 Gemini educational fallback in AI Lab. Default OFF.
# When "true", the AI Lab may call the ai-lab-explain edge function for
# unknown / educational prompts only. Deterministic scenarios are untouched.
# VITE_AI_LAB_GEMINI_ENABLED=false

# --- Backend aliases (scripts; optional if VITE_* are set) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Local migration only (npm run db:migrate-lovable) — never commit real value ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Schema repair (npm run db:apply-repair-schema) — Dashboard → Database → URI ---
SUPABASE_DB_URL=

# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets) ---
SUPABASE_ANON_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
RESEND_API_KEY=
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
RAPIDAPI_KEY=
GEMINI_API_KEY=
ENRICHMENT_WEBHOOK_SECRET=
