# Kenya Fund Finder — Supabase project qrmthciurngpzpjhevdj (currently reachable).
# Copy to .env and fill in values. Never commit .env.

# --- Frontend (Vite; safe to expose in browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Local dev only (npm run dev): skip Turnstile when Cloudflare is unreachable.
# Ignored in production builds (import.meta.env.DEV is false).
# VITE_DISABLE_TURNSTILE_DEV=true

# Phase-1 Gemini educational fallback in AI Lab. Default OFF.
# When "true", the AI Lab may call the ai-lab-explain edge function for
# unknown / educational prompts only. Deterministic scenarios are untouched.
# VITE_AI_LAB_GEMINI_ENABLED=false

# Natural-language intent parsing for casual AI Lab questions. Enabled by
# default in the client; set false for an emergency deterministic-only fallback.
VITE_AI_LAB_NATURAL_LANGUAGE_ENABLED=true
# Server-authoritative parser/execution. Browser sends prompt/context only.
VITE_AI_LAB_SERVER_AUTHORITATIVE=true

# Catalog-grounded resolver. Enabled by default; set false only as an emergency
# rollback. Shadow mode records disagreements without changing user-visible routing.
VITE_UNIVERSAL_QUERY_RESOLVER_ENABLED=true
VITE_UNIVERSAL_QUERY_RESOLVER_SHADOW=false

# --- Backend aliases (scripts; optional if VITE_* are set) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Server-side maintenance only — use a named secret key; never commit real value ---
SUPABASE_SECRET_KEY=

# --- Schema repair (npm run db:apply-repair-schema) — Dashboard → Database → URI ---
SUPABASE_DB_URL=

# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets) ---
SUPABASE_ANON_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
RESEND_API_KEY=
LOVABLE_API_KEY=
# Server-only parser model routed through LOVABLE_API_KEY.
AI_LAB_PARSER_MODEL=openai/gpt-5.6-luna
# Keep true during rollout; Gemini is only a parser outage fallback.
AI_LAB_PARSER_FALLBACK_GEMINI=true
LOVABLE_SEND_URL=
RAPIDAPI_KEY=
GEMINI_API_KEY=
ENRICHMENT_WEBHOOK_SECRET=
