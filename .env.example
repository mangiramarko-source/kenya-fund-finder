# Kenya Fund Finder — Supabase project caawgzuofnujrznwbuxk only (mangiramarko-source).
# Copy to .env and fill in values. Never commit .env.

# --- Frontend (Vite; safe to expose in browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
